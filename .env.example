# VITE_GEMINI_API_KEY: Required for browser-side Gemini AI tab triage on static deployments (e.g. Netlify).
# When omitted or when offline, TabGrave automatically falls back to its built-in local classifier.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
